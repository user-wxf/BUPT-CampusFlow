#！！！这个是个模板，自己到时候就在本地建个.env，密钥什么的就放在本地里面，千万不要提交到git上，这是个模板！！！




# DeepSeek API 密钥
# 真实值请填写在本地 .env 中，不要提交到 GitHub
DEEPSEEK_API_KEY=your_api_key_here

# JWT 登录认证使用的签名密钥
# 真实值同样只填写在本地 .env
JWT_SECRET_KEY=your_secret_here

# SMTP 邮件提醒配置
# 真实邮箱、授权码或密码只填写在本地 .env，不要提交到 GitHub
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM=your_email@example.com
SMTP_SECURITY=starttls
# 163 邮箱常见配置示例：SMTP_HOST=smtp.163.com，SMTP_PORT=465，SMTP_SECURITY=ssl
SMTP_USE_TLS=true

# Todo DDL 邮件提醒配置
REMINDER_CHECK_INTERVAL_MINUTES=5
REMINDER_LEAD_HOURS=24
REMINDER_SCHEDULER_ENABLED=true
